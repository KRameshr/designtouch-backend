# ==========================================
# DesignTouch+ Backend Environment Variables
# ==========================================

# Server Port
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Neon PostgreSQL Database
DATABASE_URL=jdbc:postgresql://<your-neon-host>/<db-name>?sslmode=require
DATABASE_USERNAME=<your-db-username>
DATABASE_PASSWORD=<your-db-password>

# CORS configuration
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Secret for Admin Authentication (generate with: openssl rand -base64 64)
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
JWT_EXPIRATION_MS=86400000

# Cloudinary Media Storage (Videos & Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Transactional Email Delivery (https://resend.com)
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=DesignTouch+ <onboarding@resend.dev>
RESEND_ENABLED=true

